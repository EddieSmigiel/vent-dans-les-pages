<footer class="footer">
    <div class="container">
        <div class="footer-grid">
            <div class="footer-brand">
                <div class="logo-text">
                    Du vent dans les pages
                    <small>Association & Maison d'édition</small>
                </div>
                <p>{{ site.footerDesc }}</p>
            </div>
            <div>
                <h4>Navigation</h4>
                <ul>
                    {% for item in navigation.footer.navigation %}
                    <li><a href="{{ item.url }}">{{ item.label }}</a></li>
                    {% endfor %}
                </ul>
            </div>
            <div>
                <h4>Informations</h4>
                <ul>
                    {% for item in navigation.footer.infos %}
                    <li><a href="{{ item.url }}">{{ item.label }}</a></li>
                    {% endfor %}
                </ul>
            </div>
            <div>
                <h4>Nous suivre</h4>
                <ul>
                    {% for item in navigation.footer.social %}
                    <li><a href="{{ item.url }}">{{ item.label }}</a></li>
                    {% endfor %}
                </ul>
            </div>
        </div>
        <div class="footer-bottom">
            &copy; {% year %} {{ site.copyright }}<br>
            <a href="/mentions-legales/">Mentions légales</a> &middot; Site réalisé par {{ site.creditDev }}
        </div>
    </div>
</footer>
