---
layout: layouts/page.njk
title: "Adhésion"
pageTag: "Rejoignez-nous"
pageHeader: "Devenir <em>adhérent</em>"
pageDesc: "Soutenez l'édition indépendante en Alsace et bénéficiez d'avantages exclusifs."
permalink: /adhesion/
---

<section class="catalogue">
    <div class="container">
        <div class="adhesion-avantages" data-reveal="up">
            <h2>{{ adhesion.avantagesTitre }}</h2>
            <div class="about-values">
                {% for avantage in adhesion.avantages %}
                <div class="value-card" data-reveal="up" data-delay="{{ loop.index0 }}">
                    <div class="value-icon">{{ avantage.icone | safe }}</div>
                    <h4>{{ avantage.titre }}</h4>
                    <p>{{ avantage.texte }}</p>
                </div>
                {% endfor %}
            </div>
        </div>
    </div>
</section>

<section class="events">
    <div class="container">
        <div class="section-header" data-reveal="up">
            <div class="section-tag">{{ adhesion.formulesTag }}</div>
            <h2 class="section-title">{{ adhesion.formulesTitre | safe }}</h2>
        </div>
        <div class="events-grid" data-reveal="up">
            {% for formule in adhesion.formules %}
            <div class="event-card">
                <h3>{{ formule.nom }}</h3>
                <p class="book-price" style="font-size: 1.5rem; margin: 0.5rem 0;">{{ formule.prix }} &euro; <small>/ an</small></p>
                <p>{{ formule.description }}</p>
            </div>
            {% endfor %}
        </div>
    </div>
</section>

<section class="catalogue">
    <div class="container">
        <div class="section-header" data-reveal="up">
            <div class="section-tag">{{ adhesion.helloassoTag }}</div>
            <h2 class="section-title">{{ adhesion.helloassoTitre | safe }}</h2>
            <p class="section-desc">{{ adhesion.helloassoDesc }}</p>
        </div>
        <div class="adhesion-widget" data-reveal="up">
            <div style="background: var(--cream); border: 2px dashed var(--green-light); border-radius: 12px; padding: 3rem; text-align: center;">
                <p style="font-size: 1.1rem; color: var(--green);">
                    <strong>Widget HelloAsso</strong><br>
                    {{ adhesion.helloassoPlaceholder }}
                </p>
                <p style="margin-top: 1rem; color: var(--text-light);">
                    {{ adhesion.helloassoFallback }} <a href="mailto:{{ site.email }}">{{ site.email }}</a>.
                </p>
            </div>
        </div>
    </div>
</section>
