---
layout: layouts/page.njk
title: "La Maison"
pageTag: "Notre histoire"
pageHeader: "La <em>Maison</em>"
pageDesc: "Une maison d'édition associative, ancrée à Strasbourg."
permalink: /association/
---

<section class="about">
    <div class="container">
        <div class="about-grid">
            <div class="about-visual" data-reveal="left">
                <blockquote>
                    &laquo;&thinsp;{{ association.citation }}&thinsp;&raquo;
                </blockquote>
                <cite>— {{ association.citationSource }}</cite>

                <div class="about-stats">
                    {% for stat in association.stats %}
                    <div class="about-stat">
                        <div class="about-stat-number">{{ stat.nombre }}</div>
                        <div class="about-stat-label">{{ stat.label }}</div>
                    </div>
                    {% endfor %}
                </div>
            </div>

            <div class="about-text" data-reveal="right">
                <h3>{{ association.presentationTitre }}</h3>
                <p>
                    {{ association.presentationTexte1 | safe }}
                </p>
                <p>
                    {{ association.presentationTexte2 | safe }}
                </p>

                <div class="about-values">
                    {% for valeur in association.valeurs %}
                    <div class="value-card" data-reveal="up" data-delay="{{ loop.index0 }}">
                        <div class="value-icon">{{ valeur.icone }}</div>
                        <h4>{{ valeur.titre }}</h4>
                        <p>{{ valeur.texte }}</p>
                    </div>
                    {% endfor %}
                </div>
            </div>
        </div>
    </div>
</section>

<section class="events">
    <div class="container">
        <div class="section-header" data-reveal="up">
            <div class="section-tag">{{ association.equipeTag }}</div>
            <h2 class="section-title">{{ association.equipeTitre | safe }}</h2>
        </div>
        <div class="about-text" data-reveal="up">
            <p>
                {{ association.equipeIntro }}
            </p>
            <ul>
                {% for membre in association.equipe %}
                <li><strong>{{ membre.role }}</strong> : {{ membre.nom }}</li>
                {% endfor %}
            </ul>
            <p>
                {{ association.comiteLecture }}
            </p>
            <div style="margin-top: 2rem;">
                <a href="/adhesion/" class="btn btn-primary">Rejoindre l'association</a>
                <a href="/contact/" class="btn btn-secondary">Nous contacter</a>
            </div>
        </div>
    </div>
</section>
