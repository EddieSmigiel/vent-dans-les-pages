---
layout: layouts/page.njk
title: "Contact"
pageTag: "Nous écrire"
pageHeader: "Restons en <em>contact</em>"
pageDesc: "Une question, un manuscrit à proposer, une collaboration ? Écrivez-nous."
permalink: /contact/
---

<section class="contact">
    <div class="container">
        <div class="contact-grid">
            <div class="contact-info" data-reveal="left">
                <h3>{{ site.name }}</h3>
                <p>{{ contact.description | safe }}</p>

                <div class="contact-details">
                    <div class="contact-item">
                        <div class="contact-icon">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/>
                                <circle cx="12" cy="10" r="3"/>
                            </svg>
                        </div>
                        <div class="contact-item-text">
                            <strong>Adresse</strong>
                            <span>{{ site.address }}</span>
                        </div>
                    </div>
                    <div class="contact-item">
                        <div class="contact-icon">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                                <polyline points="22,6 12,13 2,6"/>
                            </svg>
                        </div>
                        <div class="contact-item-text">
                            <strong>Email</strong>
                            <span>{{ site.email }}</span>
                        </div>
                    </div>
                    <div class="contact-item">
                        <div class="contact-icon">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/>
                            </svg>
                        </div>
                        <div class="contact-item-text">
                            <strong>Téléphone</strong>
                            <span>{{ site.phone }}</span>
                        </div>
                    </div>
                    <div class="contact-item">
                        <div class="contact-icon">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
                                <line x1="16" y1="2" x2="16" y2="6"/>
                                <line x1="8" y1="2" x2="8" y2="6"/>
                                <line x1="3" y1="10" x2="21" y2="10"/>
                            </svg>
                        </div>
                        <div class="contact-item-text">
                            <strong>Horaires</strong>
                            <span>{{ site.horaires }}</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="contact-form-wrapper" data-reveal="right">
                <h3>{{ contact.formeTitre }}</h3>
                <form name="contact" method="POST" data-netlify="true" netlify-honeypot="bot-field">
                    <p class="hidden" style="display:none;">
                        <label>Ne pas remplir : <input name="bot-field"></label>
                    </p>
                    <div class="form-row">
                        <div class="form-group">
                            <label for="name">Nom</label>
                            <input type="text" id="name" name="name" placeholder="Votre nom" required>
                        </div>
                        <div class="form-group">
                            <label for="email">Email</label>
                            <input type="email" id="email" name="email" placeholder="votre@email.fr" required>
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-group full">
                            <label for="subject">Objet</label>
                            <select id="subject" name="subject">
                                <option value="general">Question générale</option>
                                <option value="commande">Question sur une commande</option>
                                <option value="evenement">Événement / partenariat</option>
                                <option value="presse">Presse / média</option>
                            </select>
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-group full">
                            <label for="message">Message</label>
                            <textarea id="message" name="message" placeholder="Votre message..." required></textarea>
                        </div>
                    </div>
                    <button type="submit" class="btn btn-primary btn-full">
                        Envoyer le message
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <line x1="22" y1="2" x2="11" y2="13"/>
                            <polygon points="22 2 15 22 11 13 2 9 22 2"/>
                        </svg>
                    </button>
                </form>
            </div>
        </div>
    </div>
</section>

<!-- ===== SOUMETTRE UN MANUSCRIT ===== -->
<section class="catalogue" id="manuscrit">
    <div class="container">
        <div class="section-header" data-reveal="up">
            <div class="section-tag">{{ contact.manuscritTag }}</div>
            <h2 class="section-title">{{ contact.manuscritTitre | safe }}</h2>
            <p class="section-desc">{{ contact.manuscritDesc }}</p>
        </div>

        <div class="contact-form-wrapper" style="max-width: 640px; margin: 0 auto;" data-reveal="up">
            <form name="manuscrit" method="POST" data-netlify="true" netlify-honeypot="bot-field" enctype="multipart/form-data">
                <p class="hidden" style="display:none;">
                    <label>Ne pas remplir : <input name="bot-field"></label>
                </p>
                <div class="form-row">
                    <div class="form-group">
                        <label for="ms-name">Nom</label>
                        <input type="text" id="ms-name" name="name" placeholder="Votre nom" required>
                    </div>
                    <div class="form-group">
                        <label for="ms-email">Email</label>
                        <input type="email" id="ms-email" name="email" placeholder="votre@email.fr" required>
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group full">
                        <label for="ms-titre">Titre de l'ouvrage</label>
                        <input type="text" id="ms-titre" name="titre" placeholder="Titre provisoire ou définitif" required>
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group full">
                        <label for="ms-synopsis">Synopsis / note d'intention</label>
                        <textarea id="ms-synopsis" name="synopsis" placeholder="Présentez brièvement votre projet (10 lignes max)..." required></textarea>
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group full">
                        <label for="ms-fichier">Manuscrit (PDF, DOC, max 10 Mo)</label>
                        <input type="file" id="ms-fichier" name="fichier" accept=".pdf,.doc,.docx,.odt">
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group full">
                        <label for="ms-dossier">Dossier d'accompagnement (PDF, DOC, max 10 Mo)</label>
                        <input type="file" id="ms-dossier" name="dossier" accept=".pdf,.doc,.docx,.odt">
                    </div>
                </div>
                <button type="submit" class="btn btn-primary btn-full">
                    Envoyer le manuscrit
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <line x1="22" y1="2" x2="11" y2="13"/>
                        <polygon points="22 2 15 22 11 13 2 9 22 2"/>
                    </svg>
                </button>
            </form>
        </div>
    </div>
</section>
