---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
    <url>
        <loc>{{ site.url }}/</loc>
        <changefreq>weekly</changefreq>
        <priority>1.0</priority>
    </url>
    <url>
        <loc>{{ site.url }}/catalogue/</loc>
        <changefreq>weekly</changefreq>
        <priority>0.9</priority>
    </url>
    <url>
        <loc>{{ site.url }}/association/</loc>
        <changefreq>monthly</changefreq>
        <priority>0.7</priority>
    </url>
    <url>
        <loc>{{ site.url }}/blog/</loc>
        <changefreq>weekly</changefreq>
        <priority>0.8</priority>
    </url>
    <url>
        <loc>{{ site.url }}/evenements/</loc>
        <changefreq>weekly</changefreq>
        <priority>0.7</priority>
    </url>
    <url>
        <loc>{{ site.url }}/adhesion/</loc>
        <changefreq>monthly</changefreq>
        <priority>0.6</priority>
    </url>
    <url>
        <loc>{{ site.url }}/contact/</loc>
        <changefreq>monthly</changefreq>
        <priority>0.6</priority>
    </url>
    {%- for livre in collections.livres %}
    <url>
        <loc>{{ site.url }}{{ livre.url }}</loc>
        <lastmod>{{ livre.date | dateIso }}</lastmod>
        <changefreq>monthly</changefreq>
        <priority>0.8</priority>
    </url>
    {%- endfor %}
    {%- for article in collections.blog %}
    <url>
        <loc>{{ site.url }}{{ article.url }}</loc>
        <lastmod>{{ article.date | dateIso }}</lastmod>
        <changefreq>monthly</changefreq>
        <priority>0.6</priority>
    </url>
    {%- endfor %}
</urlset>
